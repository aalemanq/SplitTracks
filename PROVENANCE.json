{
  "application": "Split Tracks",
  "version": "0.3.0",
  "platform": "Ubuntu 24.04+ x86_64",
  "runtime": {
    "python": ".venv/bin/python",
    "torch": "2.11.0+cpu",
    "torchaudio": "2.11.0+cpu",
    "demucs": "4.1.0",
    "model": "htdemucs_6s",
    "audio": "FFmpeg discovered at runtime",
    "playback": "GStreamer 1.x discovered at runtime",
    "youtube_downloader": "bin/yt-dlp"
  },
  "model_outputs": ["vocals", "drums", "bass", "guitar", "piano", "other"],
  "privacy": "Audio is processed locally. Network access is used only for YouTube downloads and first-time model download."
}
